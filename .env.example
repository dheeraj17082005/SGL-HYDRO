# SGL Smart CNG Station - Environment Variables Template
# Copy this file to .env and fill in real credentials before starting

# Vehicle Verification Provider Options: "mock" or "rapidapi"
VEHICLE_VERIFICATION_PROVIDER=rapidapi

# RapidAPI Configuration (Rappid Technologies / RTO RC Verification)
RAPIDAPI_KEY=YOUR_RAPIDAPI_KEY
RAPIDAPI_HOST=vehicle-rc-information.p.rapidapi.com
RAPIDAPI_URL=https://vehicle-rc-information.p.rapidapi.com/

# Spring Boot Database Configuration (Default: H2 in-memory or PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:h2:mem:sgl_cng;DB_CLOSE_DELAY=-1;MODE=PostgreSQL
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
